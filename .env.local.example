# Template. Never put real values in this file -- it is meant to be committed.
# Real values belong in .env.local, which .gitignore covers.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS -- used by the Dodo webhook and the digest cron.
SUPABASE_SERVICE_ROLE_KEY=

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_ID_MONTHLY=
DODO_PRODUCT_ID_ANNUAL=

# Resend
RESEND_API_KEY=
# Until a domain is verified at resend.com/domains, Resend runs in test mode:
# the only usable sender is onboarding@resend.dev, and the only deliverable
# recipient is the Resend account owner's own address. Verifying a domain lifts
# both limits -- then set this to an address on that domain.
DIGEST_FROM_EMAIL="FollowUp <onboarding@resend.dev>"

# Protects /api/cron/digest. Vercel sends this as `Authorization: Bearer <value>`.
# Also gates the ?hour= override used to trigger a run on demand.
CRON_SECRET=

# Used for the "Open your list" link in the digest. Must be the real origin in
# production, or every digest links people back to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
